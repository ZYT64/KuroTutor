{
  "name": "KuroTutor",
  "version": "0.7.3",
  "workspace": "data/workspaces",
  "data_dir": "data",
  "channel": {
    "app_id": "请填写QQ机器人app_id",
    "secret": "请填写QQ机器人secret"
  },
  "models": {
    "llm": {
      "provider": "openai",
      "model": "deepseek-v3",
      "api_key": "请填写密钥",
      "base_url": "https://api.deepseek.com/v1"
    },
    "vision": {
      "provider": "openai",
      "model": "qwen-vl-plus",
      "api_key": "请填写密钥",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1"
    },
    "embedding": {
      "provider": "openai",
      "model": "embedding-3",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "api_key": "你的嵌入模型key（可与主模型同key，如智谱 embedding-3）"
    },
    "reranker": {
      "provider": "openai",
      "model": "bge-reranker-v2-m3",
      "api_key": "请填写密钥"
    },
    "search": {
      "provider": "bing",
      "model": "",
      "api_key": ""
    },
    "qbank": {
      "provider": "huohua",
      "model": "",
      "api_key": ""
    }
  },
  "permissions": {
    "shell": "deny",
    "file_access": "workspace_only",
    "model_endpoints": [
      "https://api.deepseek.com",
      "https://dashscope.aliyuncs.com"
    ]
  },
  "kb": {
    "vector_store": "sqlite-vec",
    "path": "data/kb"
  },
  "paths": {
    "skills_dir": "skills",
    "plugins_dir": "plugins"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "log_level": "info",
  "openmaic": {
    "base_url": "https://open.maic.chat",
    "access_code": ""
  },
  "backup": {
    "gitee_repo": "",
    "gitee_user": "",
    "gitee_token": "",
    "encrypt_password": "",
    "auto_enabled": true,
    "auto_interval_days": 1
  },
  "ocr": {
    "chain": [
      "baidu",
      "tencent",
      "local"
    ],
    "baidu_api_key": "",
    "baidu_secret_key": "",
    "tencent_secret_id": "",
    "tencent_secret_key": "",
    "mineru_token": ""
  }
